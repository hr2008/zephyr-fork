if BOARD_BEAGLEBONE_BLACK

config BOARD
	default "beaglebone_black"

config CONSOLE
	default y

config UART_CONSOLE
	default y

config SERIAL
	default y

config GPIO
	default y

config GPIO_AM335X
	bool
	default y if GPIO

config UART_AM335X
	bool
	default y if SERIAL

# Pin control
config PINCTRL
	bool
	default y

config PINCTRL_AM335X
	bool
	default y if PINCTRL



endif # BOARD_BEAGLEBONE_BLACK
