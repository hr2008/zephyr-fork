# BeagleBone Black Board Configuration
# TI AM335x (Cortex-A8) - DDR RAM execution

# SoC Configuration
CONFIG_SOC_SERIES_AM335X=y
CONFIG_SOC_AM335X=y

# Memory Configuration
CONFIG_XIP=n
CONFIG_SRAM_BASE_ADDRESS=0x80000000
CONFIG_SRAM_SIZE=262144

# Disable MMU for simpler configuration


# Console and Serial
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_PRINTK=y
CONFIG_EARLY_CONSOLE=y

# GPIO
CONFIG_GPIO=y

# Pin Control
CONFIG_PINCTRL=y

# Timer (System Clock)
CONFIG_AM335X_TIMER=y
CONFIG_SYS_CLOCK_EXISTS=y
CONFIG_SYS_CLOCK_TICKS_PER_SEC=100
CONFIG_TICKLESS_KERNEL=y

# Interrupt Controller
# Note: Interrupt controller is built into SoC code, no separate config needed

# Stack Sizes
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_IDLE_STACK_SIZE=1024
CONFIG_ISR_STACK_SIZE=2048
CONFIG_THREAD_STACK_INFO=y

# Memory Pool
CONFIG_HEAP_MEM_POOL_SIZE=131072

# System initialization
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=2048

# Kernel Options
CONFIG_KERNEL_ENTRY="__start"
CONFIG_KERNEL_BIN_NAME="zephyr"

# Boot Options
CONFIG_BOOT_BANNER=y
CONFIG_BOOT_DELAY=0


# Build Options
CONFIG_SIZE_OPTIMIZATIONS=n

CONFIG_GEN_ISR_TABLES=y
CONFIG_DYNAMIC_INTERRUPTS=y

CONFIG_INTC_AM335X=y

# Cortex-A uses static vector table
CONFIG_GEN_ISR_TABLES=n
CONFIG_IRQ_OFFLOAD=n
CONFIG_DYNAMIC_INTERRUPTS=n

# Required for Cortex-A
CONFIG_MULTI_LEVEL_INTERRUPTS=n
